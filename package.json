{
  "name": "website-design-dogs-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:verify": "node scripts/verify-assets.mjs",
    "leads:test": "node --test tests/leads.test.mjs",
    "launch:test": "node --test tests/launch.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "build:audit": "node scripts/audit-production-build.mjs",
    "env:check": "node scripts/check-production-env.mjs",
    "content:test": "node --test tests/content-integrity.test.mjs",
    "visual:extract": "node scripts/extract-mockup-references.mjs",
    "visual:capture": "node scripts/capture-mockup-pages.mjs",
    "visual:compare": "node scripts/compare-mockup-pages.mjs",
    "visual:test": "rm -rf test-results/visual && npm run assets:verify && npm run visual:extract && npm run build && sh -c 'npm run start > /tmp/wdd-next.log 2>&1 & echo $! > /tmp/wdd-next.pid; sleep 5; npm run visual:capture && npm run visual:compare; status=$?; kill $(cat /tmp/wdd-next.pid); exit $status'"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "@playwright/test": "1.55.0"
  }
}
