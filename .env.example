# Public site URL used for canonical URLs, sitemap, Open Graph, structured data, and allowed lead origins.
NEXT_PUBLIC_SITE_URL=https://www.websitedesigndogs.com

# Lead routing. Email is the permanent safety channel; Bizosto becomes the system of record once certified.
LEAD_SUBMISSION_ENABLED=false
LEAD_EMAIL_ENABLED=true
LEAD_BIZOSTO_ENABLED=false
LEAD_ALLOWED_ORIGINS=https://websitedesigndogs.com,https://www.websitedesigndogs.com
LEAD_REQUEST_TIMEOUT_MS=10000
LEAD_EMAIL_TIMEOUT_MS=8000
LEAD_RATE_LIMIT_WINDOW_MS=600000
LEAD_RATE_LIMIT_MAX=5
LEAD_DISTRIBUTED_RATE_LIMIT_ID=wdd-lead-submission
LEAD_DISTRIBUTED_RATE_LIMIT_REQUIRED=true
ALLOW_PREVIEW_LEAD_SUBMISSION=false

# Permanent WDD email safety channel, delivered through Resend server-side only.
# Verify websitedesigndogs.com in Resend before enabling live submissions.
# SECRET: configure this in Vercel or .env.local only; never expose it to browser code.
RESEND_API_KEY=
LEAD_EMAIL_FROM=Website Design Dogs <leads@websitedesigndogs.com>
LEAD_EMAIL_TO=leads@websitedesigndogs.com

# Bizosto server-only configuration. Enable LEAD_BIZOSTO_ENABLED only after the WDD tenant is certified.
BIZOSTO_API_URL=https://app.bizosto.com/api/ingest/leads
# SECRET: configure this in Vercel or .env.local only; never expose it to browser code.
BIZOSTO_INGEST_KEY=

# Cloudflare Turnstile managed widget. The secret is server-only; the site key is public.
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=websitedesigndogs.com,www.websitedesigndogs.com

# Consent-controlled Google Tag Manager foundation. GTM is preferred for GA4 and Meta tags.
NEXT_PUBLIC_ENABLE_GTM=true
NEXT_PUBLIC_GTM_ID=GTM-N625DJ7Z
NEXT_PUBLIC_CONSENT_BANNER_ENABLED=true
NEXT_PUBLIC_CONSENT_DEBUG=false
NEXT_PUBLIC_INSTAGRAM_URL=

# Optional Meta Conversions API. Activate only with the legitimate Website Design Dogs dataset.
# META_GRAPH_API_VERSION must be set to the current supported version selected in Meta Events Manager.
META_CAPI_ENABLED=false
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
META_CAPI_TIMEOUT_MS=4000
META_CAPI_TEST_EVENT_CODE=

# Optional search and domain verification values configured in Vercel only when issued by the provider.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# Browser tags remain consent-controlled through GTM. Meta CAPI credentials stay server-only.
