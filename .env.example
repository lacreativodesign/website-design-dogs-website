# Public site URL used for canonical URLs, sitemap, Open Graph, structured data, and allowed lead origins.
NEXT_PUBLIC_SITE_URL=https://websitedesigndogs.com

# Lead routing and Bizosto server-only configuration. Do not expose these values in browser code.
LEAD_SUBMISSION_ENABLED=false
BIZOSTO_API_URL=
BIZOSTO_TENANT_ID=
BIZOSTO_API_KEY=
BIZOSTO_API_KEY_HEADER=x-api-key
BIZOSTO_TENANT_HEADER=x-tenant-id
LEAD_ALLOWED_ORIGINS=
LEAD_REQUEST_TIMEOUT_MS=10000
LEAD_RATE_LIMIT_WINDOW_MS=600000
LEAD_RATE_LIMIT_MAX=5
ALLOW_PREVIEW_LEAD_SUBMISSION=false

# Cloudflare Turnstile. The secret is server-only; the site key is public.
TURNSTILE_REQUIRED=true
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Consent-controlled Google Tag Manager foundation. GTM is preferred for GA4 and Meta tags.
NEXT_PUBLIC_ENABLE_GTM=false
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CONSENT_BANNER_ENABLED=true
NEXT_PUBLIC_CONSENT_DEBUG=false

# Optional search and domain verification values configured in Vercel only when issued by the provider.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# Reserved for future documented integrations. Do not enable direct duplicate tracking with GTM.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
